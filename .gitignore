.DS_Store
Icon?
.claude/*
!.claude/commands/
!.claude/skills/
!.claude/.gems-sync.json
.conductor/
__pycache__/
*.pyc
node_modules/
config.json
.stello-sync

# Local env files (never committed)
.env
.env.*
.vercel/

# Local backup mirror — regenerated by `npm run backup`, not source of truth
_items/
index.json
_backups/

# Cloudflare Workers build output
dist/
.wrangler/
.dev/

# desktop-context daemon (Python sidecar) — venv + caches stay local
desktop-context/.venv/
desktop-context/**/__pycache__/
desktop-context/.pytest_cache/
desktop-context/**/*.pyc
desktop-context/*.egg-info/

# Native Apple app — Xcode build output / QA artifacts (regenerated, not source)
apple/Stello/.build-artifacts/
**/DerivedData/
**/xcuserdata/
*.xcuserstate
# iCloud duplicate .xcodeproj siblings (from the XcodeGen era; still harmless to ignore)
apple/**/*[0-9].xcodeproj/
