# Stello local dev — copy to .dev.vars (wrangler dev reads it) and fill in.
# Both are optional locally.

# Fallback Anthropic key for /api/enrich when a user has none saved in Settings.
ANTHROPIC_API_KEY=

# Gates /api/admin/* and /api/cron/drain-enrichment. Unset = those routes are off.
ADMIN_TOKEN=
