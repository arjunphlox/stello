# Stello local dev — copy to .env.local and fill in the secrets.
# .env.local is gitignored; .env.example is the shape reference.

# Public (safe to share) — these match what ships in supabase-client.js
SUPABASE_URL=https://ngncjtzsqrrfrhgammne.supabase.co
SUPABASE_ANON_KEY=sb_publishable_r7udhKoy2jEtBrcbKY1wGg_LFn-wMjR

# Secret — fetch from Supabase dashboard → Settings → API Keys → "Secret" / sb_secret_*
# Needed for admin operations (cron batch processor, storage uploads on behalf of users)
SUPABASE_SERVICE_ROLE_KEY=

# Optional — only required if you want to test /api/enrich for users who
# don't have their own Anthropic key saved in Settings. Otherwise leave blank.
ANTHROPIC_API_KEY=
