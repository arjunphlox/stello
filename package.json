{
  "name": "stello",
  "version": "0.0.0",
  "private": true,
  "description": "Personal knowledge base \u2014 rich item analysis and discovery",
  "scripts": {
    "build": "node scripts/build-assets.js",
    "dev": "node scripts/build-assets.js && wrangler dev",
    "dev:up": "dev-up",
    "dev:down": "dev-down",
    "dev:remote": "node scripts/build-assets.js && wrangler dev --remote",
    "deploy": "node scripts/build-assets.js && wrangler deploy",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "wrangler": "^4.99.0"
  }
}
