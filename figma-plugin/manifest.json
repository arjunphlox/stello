{
  "name": "Stello",
  "id": "stello-figma-dev",
  "api": "1.0.0",
  "main": "code.js",
  "ui": "ui.html",
  "editorType": ["figma", "figjam"],
  "documentAccess": "dynamic-page",
  "enablePrivatePluginApi": true,
  "networkAccess": {
    "allowedDomains": ["https://stello.arjunphlox.workers.dev"],
    "devAllowedDomains": ["http://localhost:8787"],
    "reasoning": "Reads your Stello library and saves boards back to your Stello account."
  },
  "relaunchButtons": [
    { "command": "open-source", "name": "Open source", "multipleSelection": false },
    { "command": "open-stello", "name": "Open in Stello", "multipleSelection": false },
    { "command": "panel", "name": "Stello" }
  ]
}
