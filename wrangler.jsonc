{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stello",
  "main": "src/index.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static frontend. dist/ is an allowlisted copy of the frontend files
  // (scripts/build-assets.js) — the repo root holds the knowledge-base .md
  // content + tooling that must NOT be served. run_worker_first routes the
  // API + image-serving paths to the Worker; everything else is a static asset.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/img/*"],
    "html_handling": "auto-trailing-slash"
  },

  // Image bytes live in R2 (zero egress), served back via GET /img/*.
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "stello-item-images" }
  ],

  // Items, accounts and sessions (replaces Supabase). Schema is applied by
  // the Worker itself (src/lib/schema.js ← migrations/0001_init.sql).
  "d1_databases": [
    { "binding": "DB", "database_name": "stello", "database_id": "acfb6760-4a81-4606-aeee-359c16a8719e" }
  ],

  // Lets the Worker import migrations/*.sql as text.
  "rules": [
    { "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }
  ],

  // sharp replacement — WebP encode + resize at ingest via the Images binding.
  "images": { "binding": "IMAGES" },

  // Daily batch drain (was vercel.json crons → /api/cron/process-batches).
  "triggers": { "crons": ["0 0 * * *"] },

  "observability": { "enabled": true },

  // Public values. Secrets (ANTHROPIC_API_KEY, ADMIN_TOKEN) via `wrangler secret put`.
  "vars": {
    // Sign in with Apple. APPLE_SERVICES_ID is the web Services ID; empty
    // hides the button. APPLE_APP_IDS are the app bundle ids allowed to sign
    // in natively (comma-separated).
    "APPLE_SERVICES_ID": "com.arjunphlox.Stello.web",
    "APPLE_APP_IDS": "com.arjunphlox.Stello",
    // Open sign-up for new email / Apple accounts. Off: Stello is invite-only.
    "ALLOW_SIGNUP": "false"
  }
}
