{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stello",
  "main": "src/index.js",
  "compatibility_date": "2025-04-01",

  // Static frontend. dist/ is an allowlisted copy of the frontend files
  // (scripts/build-assets.js) — the repo root holds the knowledge-base .md
  // content + tooling that must NOT be served. Only /img/* runs the Worker
  // first; everything else is a static asset.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/img/*"],
    "html_handling": "auto-trailing-slash"
  },

  // Legacy item images, kept until the Supabase-era library is imported
  // into iCloud (the export references them as /img/<key>).
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "stello-item-images" }
  ],

  // No scheduled jobs any more: an empty list removes the old daily cron on deploy.
  "triggers": { "crons": [] },

  "observability": { "enabled": true }
}
